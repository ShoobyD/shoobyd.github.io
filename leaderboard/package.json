{
  "name": "shoobyd-tower-leaderboard",
  "version": "1.0.0",
  "private": true,
  "description": "Leaderboard API for the Tower of Babel brick-stacking game on shoobyd.github.io (Cloudflare Worker + D1).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply tower-leaderboard --local",
    "migrate:remote": "wrangler d1 migrations apply tower-leaderboard --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}

