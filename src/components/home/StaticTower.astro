---
/**
 * The still tower, behind the climb when there is no live 3D one (reduced motion, no WebGL2,
 * Save-Data, `?no3d`, or the scene gave up): one picture of the whole tower with every tier's
 * point of interest turned to the front, standing on its plain: a CSS gradient below a sharp
 * horizon behind its foot, with the plain's houses and trees laid side by side across the whole
 * window in the whole tower's view, fading out as it closes in (the tower and the houses rendered by
 * scripts/render-tower-still.mjs, from one camera, so everything lines up exactly). It stands
 * behind the climb the live tower would (../tower/still-climb.ts runs the panels) and follows the
 * same progress: each tier's focus comes level with that tier's fixed panel on wide screens, and
 * sits in the room above its bottom sheet on phones (following the sheet as it opens or
 * collapses). It is close at each tier and draws back a little on the way between two; at the
 * base, where the page opens, it shows the whole tower, and closes in on the way up. The ground
 * moves and scales with it.
 * With reduced motion it doesn't travel: it holds each tier's view and fades to the next one's.
 * With Save-Data none of it is fetched.
 *
 * Decorative (`aria-hidden`; the panels carry the content), and only there with JavaScript: the
 * script picks the image size and does the placing, so without it nothing is fetched. Hidden
 * while the 3D tower is up (`html.webgl`).
 */
import { getImage } from 'astro:assets';
import tower from '../../assets/images/tower-front.webp';
import groundTile from '../../assets/images/tower-ground.webp';
import still from '../../data/tower-front.json';

/** Served widths; the script's `sizes` picks one for the zoomed-in size on screen. */
const WIDTHS = [900, 1500, 2100];
const sources = await Promise.all(WIDTHS.map((width) => getImage({ src: tower, width, format: 'webp', quality: 80 })));
const srcset = sources.map((s, i) => `${s.src} ${WIDTHS[i]}w`).join(', ');
const ground = await getImage({ src: groundTile, format: 'webp', quality: 80 });
const layout = { foci: still.foci, axis: still.axis, size: [still.width, still.height], ground: { ...still.ground, src: ground.src } };
---

<!-- the pictures themselves are added by the script below (without JavaScript nothing is fetched) -->
<div class="static-tower-ground" data-static-ground aria-hidden="true"></div>
<div class="static-tower" data-static-tower data-srcset={srcset} data-layout={JSON.stringify(layout)} aria-hidden="true"></div>

<script>
	import { isTowerActive, progressAt, sectionHolds, sectionTops } from '../tower/mode';

	interface Layout {
		foci: number[];
		axis: number;
		size: [number, number];
		/** the houses' tile and where it sits; `horizon` is the plain's edge within it, `far`/`near` its colours */
		ground: { width: number; height: number; top: number; horizon: number; axis: number; far: string; near: string; src: string };
	}

	const box = document.querySelector<HTMLElement>('[data-static-tower]');
	const groundLayer = document.querySelector<HTMLElement>('[data-static-ground]');
	const img = box ? document.createElement('img') : null;
	const sections = ['base', 'code', 'math', 'languages', 'making', 'summit'].map((id) => document.getElementById(`tier-${id}`));

	if (box && groundLayer && img && sections.every(Boolean)) {
		const tiers = sections as HTMLElement[];
		const panels = tiers.map((s) => s.querySelector<HTMLElement>('[data-tier-panel]')!);
		const layout = JSON.parse(box.dataset.layout ?? '{}') as Layout;
		const { foci } = layout;
		const phone = window.matchMedia('(max-width: 47.5rem)');
		img.className = 'static-tower__img';
		img.alt = '';
		img.decoding = 'async';
		[img.width, img.height] = layout.size;
		box.append(img);
		/**
		 * The ground: one long strip of the plain, and along its top the houses' tile, repeated. The
		 * houses belong to the view of the whole tower: drawn at the tower's scale they would loom far
		 * too large when it is close, so they fade out as it closes in, and only the plain stays.
		 */
		const ground = document.createElement('div');
		ground.className = 'static-tower__ground';
		const houses = document.createElement('div');
		houses.className = 'static-tower__houses';
		ground.append(houses);
		groundLayer.append(ground);
		/** Tiles in the strip, either side of the one under the tower: enough to fill the window when drawn back. */
		const TILES = 15;

		/** How close the tower is: at a tier, and the least it draws back to half-way between two. */
		const zoom = () => (phone.matches ? { near: 2.3, far: 1.9 } : { near: 2, far: 1.7 });
		/** The houses' opacity at scale `s`: there in the whole tower's view, gone once it is close. */
		const housesAt = (s: number) => {
			const x = Math.min(1, Math.max(0, (s - 1) / 0.4));
			return 1 - x * x * (3 - 2 * x);
		};
		/** 0 at a tier, 1 half-way to the next: flat around each tier, the change mostly in between. */
		const away = (t: number) => {
			const d = Math.min(t, 1 - t) * 2;
			const x = Math.min(1, Math.max(0, (d - 0.15) / 0.85));
			return x * x * (3 - 2 * x);
		};

		/** Reduced motion: the tower doesn't travel; it fades from one tier's view to the next. */
		const still = window.matchMedia('(prefers-reduced-motion: reduce)');
		// Save-Data: the pictures are decoration, so they aren't fetched at all (nothing shows)
		const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
		/**
		 * Fetched only once it is wanted: a climb is running the page (`data-climb`) without the live
		 * tower, that is the still climb (at once on its own path; when the 3D drops out or never
		 * comes). Behind the live tower it would never show.
		 */
		const root = document.documentElement;
		let fetched = false;
		function fetchPicture() {
			if (fetched || saveData || root.dataset.climb !== 'live' || isTowerActive()) return;
			fetched = true;
			// the size to fetch: the picture is drawn this much wider than its base width
			img!.sizes = `calc(${phone.matches ? '100vw' : '46vw'} * ${zoom().near})`;
			img!.srcset = box!.dataset.srcset ?? '';
		}
		new MutationObserver(fetchPicture).observe(root, { attributeFilter: ['class', 'data-climb'] });
		fetchPicture();

		/** Below the fixed header. */
		const TOP = 72;
		/**
		 * Where tier `k`'s focus should sit on screen: level with the middle of its panel, or (phone)
		 * in the middle of the room between the header and its bottom sheet, open or collapsed.
		 */
		function spot(k: number) {
			const r = panels[k].getBoundingClientRect();
			return phone.matches ? (TOP + r.top) / 2 : r.top + r.height / 2;
		}

		/** Where the climb is: between tier `i` and the next, `t` of the way (the same progress as the panels'). */
		function where() {
			const p = progressAt(sectionTops(tiers), window.scrollY, sectionHolds(tiers));
			const i = Math.min(tiers.length - 2, Math.floor(p));
			return { i, t: Math.min(1, Math.max(0, p - i)) };
		}

		/** The transform that puts `focus` (a fraction of the picture's height) at `y` on screen, at scale `s`. */
		function framing(focus: number, y: number, s: number) {
			const w0 = img!.offsetWidth;
			const boxW = box!.clientWidth;
			// the image sits at the box's inline-start edge: in RTL that is its right edge
			const rtl = getComputedStyle(box!).direction === 'rtl';
			const left = boxW / 2 - (s * w0) / 2;
			return { x: left - (rtl ? boxW - w0 : 0), y: y - s * focus * img!.offsetHeight, s };
		}

		/** Where the tower should be for the current scroll (translate x/y and scale). */
		function aim() {
			const { i, t } = where();
			const { near, far } = zoom();
			// from the base to the code tier: out of the whole tower, in to the doors
			if (i === 0) {
				const whole = overview();
				const e = t * t * (3 - 2 * t);
				const s = whole.s + (near - whole.s) * e;
				return framing(whole.focus + (foci[1] - whole.focus) * e, whole.y + (spot(1) - whole.y) * e, s);
			}
			const target = spot(i) + (spot(i + 1) - spot(i)) * t;
			return framing(foci[i] + (foci[i + 1] - foci[i]) * t, target, near - (near - far) * away(t));
		}

		/**
		 * The base tier's view: the whole tower, as on landing in the 3D climb. It fits the room below
		 * the header, its middle in the middle of it: beside the panel on wide screens (leaving the
		 * bottom of the window to the plain it stands on), above it on a phone (down to just past the
		 * panel's top, so its foot tucks under).
		 */
		function overview() {
			const top = TOP;
			const bottom = phone.matches ? panels[0].getBoundingClientRect().top + 36 : window.innerHeight - Math.max(110, window.innerHeight * 0.17);
			const room = Math.max(160, bottom - top);
			const s = Math.min((room * 0.94) / img!.offsetHeight, (box!.clientWidth * 0.96) / img!.offsetWidth);
			return { s, focus: 0.5, y: top + room / 2 };
		}

		/**
		 * Sizes the ground strip to the tower as drawn at scale 1 (the tile at the tower's pixel scale):
		 * the houses and trees repeated along the top, over the plain, which starts at a sharp horizon
		 * a little behind the tower's foot and deepens towards the front.
		 */
		function sizeGround() {
			const k = img!.offsetWidth / layout.size[0];
			const tileW = layout.ground.width * k, tileH = layout.ground.height * k;
			const edge = layout.ground.horizon * tileH;
			const { far, near } = layout.ground;
			ground.style.inlineSize = `${(TILES * tileW).toFixed(1)}px`;
			// tall enough to reach the bottom of the window even drawn at its smallest (the whole tower,
			// at the base): a full window's height at that scale, from wherever its top is on screen
			const least = Math.min(overview().s, zoom().far);
			ground.style.blockSize = `${(tileH + Math.max(img!.offsetHeight * 2, window.innerHeight / least)).toFixed(1)}px`;
			ground.style.backgroundImage = `linear-gradient(transparent ${edge.toFixed(1)}px, ${far} ${edge.toFixed(1)}px, ${near} ${tileH.toFixed(1)}px, ${near})`;
			houses.style.blockSize = `${tileH.toFixed(1)}px`;
			houses.style.backgroundImage = `url("${layout.ground.src}")`;
			houses.style.backgroundSize = `${tileW.toFixed(1)}px ${tileH.toFixed(1)}px`;
			return { tileW, tileH };
		}

		/** Draws the tower at framing `f`, and its ground under it with the same move and scale. */
		function place(f: { x: number; y: number; s: number }) {
			img!.style.transform = `translate(${f.x.toFixed(1)}px, ${f.y.toFixed(1)}px) scale(${f.s.toFixed(4)})`;
			const { tileW } = groundSize;
			const w0 = img!.offsetWidth, h0 = img!.offsetHeight;
			// the tower's top-left corner on screen before its transform, and the ground strip's
			const b = box!.getBoundingClientRect();
			const rtl = getComputedStyle(box!).direction === 'rtl';
			const imgX = b.left + (rtl ? b.width - w0 : 0), imgY = b.top;
			const layer = groundLayer!.getBoundingClientRect();
			const gw = TILES * tileW;
			const groundX = layer.left + (rtl ? layer.width - gw : 0), groundY = layer.top;
			// in the tower's own (unscaled) coordinates: the strip's axis column under the tower's axis,
			// its top where the band starts
			const stripAxis = Math.floor(TILES / 2) * tileW + layout.ground.axis * tileW;
			const lx = layout.axis * w0 - stripAxis, ly = layout.ground.top * h0;
			const tx = imgX + f.x + f.s * lx - groundX, ty = imgY + f.y + f.s * ly - groundY;
			ground.style.transform = `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${f.s.toFixed(4)})`;
			houses.style.opacity = housesAt(f.s).toFixed(3);
		}
		let groundSize = { tileW: 0, tileH: 0 };

		/** Reduced motion: the view of the nearest tier, held still. */
		let shownTier = -1;
		let fading = 0;
		function hold(force: boolean) {
			const { i, t } = where();
			const k = t < 0.5 ? i : i + 1;
			if (k === shownTier && !force) return;
			const apply = () => {
				shownTier = k;
				const whole = overview();
				place(k === 0 ? framing(whole.focus, whole.y, whole.s) : framing(foci[k], spot(k), zoom().near));
				box!.classList.remove('is-fading');
				groundLayer!.classList.remove('is-fading');
			};
			window.clearTimeout(fading);
			if (force || shownTier < 0) return apply();
			// out, the new view set while it can't be seen, back in
			box!.classList.add('is-fading');
			groundLayer!.classList.add('is-fading');
			fading = window.setTimeout(apply, 220);
		}

		// eased toward its aim every frame, so a wheel's steps come out smooth
		const now = { x: 0, y: 0, s: 1 };
		let first = true;
		let frame = 0;
		let last = 0;
		function draw(time: number) {
			frame = 0;
			if (isTowerActive() || !img!.complete || !img!.naturalWidth) return;
			if (first) groundSize = sizeGround();
			if (still.matches) {
				hold(first);
				first = false;
				return;
			}
			const to = aim();
			const dt = last ? Math.min(0.1, (time - last) / 1000) : 0;
			last = time;
			const k = first ? 1 : 1 - Math.exp(-dt * 12);
			first = false;
			// a view measured while nothing could be measured (hidden, mid-switch) starts over from its aim
			if (!Number.isFinite(now.x + now.y + now.s)) Object.assign(now, to);
			now.x += (to.x - now.x) * k;
			now.y += (to.y - now.y) * k;
			now.s += (to.s - now.s) * k;
			place(now);
			const moving = Math.abs(to.y - now.y) > 0.3 || Math.abs(to.s - now.s) > 0.0005 || Math.abs(to.x - now.x) > 0.3;
			if (moving || time < followUntil) schedule();
			else last = 0;
		}
		function schedule() {
			if (!frame) frame = requestAnimationFrame(draw);
		}

		/**
		 * A bottom sheet opening or collapsing (phones) moves the room above it: the view follows it
		 * while it slides (as the 3D camera lifts with it), or with reduced motion settles once it has.
		 */
		let followUntil = 0;
		let settle = 0;
		const SHEET_SLIDE = 460;
		const sheets = new MutationObserver((changes) => {
			const slid = changes.some((c) => (c.oldValue ?? '').includes('is-sheet-collapsed') !== (c.target as HTMLElement).classList.contains('is-sheet-collapsed'));
			if (!slid || !phone.matches) return;
			if (still.matches) {
				window.clearTimeout(settle);
				settle = window.setTimeout(() => hold(true), SHEET_SLIDE);
				return;
			}
			followUntil = performance.now() + SHEET_SLIDE;
			schedule();
		});
		panels.forEach((p) => sheets.observe(p, { attributeFilter: ['class'], attributeOldValue: true }));

		img.addEventListener('load', () => {
			box.dataset.ready = '';
			groundLayer.dataset.ready = '';
			first = true;
			schedule();
		});
		window.addEventListener('scroll', schedule, { passive: true });
		const replace = () => {
			first = true;
			schedule();
		};
		window.addEventListener('resize', replace);
		still.addEventListener('change', replace);
		// the layout changes as the climb starts, and when the live tower comes or goes: place it again then
		new ResizeObserver(replace).observe(document.body);
	}
</script>

<style>
	.static-tower,
	.static-tower-ground {
		display: none;
		position: fixed;
		z-index: 0;
		inset-block: 0;
		overflow: hidden;
		pointer-events: none;
		transition: opacity 0.22s ease;
	}
	/* the tower stands in the inline-end part of the window, and when close it carries on past it,
	 * behind the panel (whose glass blurs it), as the live tower does */
	.static-tower {
		inset-inline-end: 0;
		inline-size: 60vw;
		overflow: visible;
	}
	/* the ground runs the whole width, under the panels too */
	.static-tower-ground {
		inset-inline: 0;
	}
	/* reduced motion: between two tiers' views the tower fades out and back in, instead of travelling */
	.static-tower.is-fading,
	.static-tower-ground.is-fading {
		opacity: 0;
	}
	/* shown once its picture is in, only without the live tower */
	:global(html:not(.webgl)) .static-tower[data-ready],
	:global(html:not(.webgl)) .static-tower-ground[data-ready] {
		display: block;
	}

	/* the pictures are created by the script, so they are outside this file's scope */
	.static-tower :global(.static-tower__img) {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
		inline-size: 46vw;
		block-size: auto;
		max-inline-size: none;
		transform-origin: 0 0;
		will-change: transform;
	}
	.static-tower-ground :global(.static-tower__ground) {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
		background-repeat: no-repeat;
		transform-origin: 0 0;
		will-change: transform;
	}
	.static-tower-ground :global(.static-tower__houses) {
		position: absolute;
		inset-block-start: 0;
		inset-inline: 0;
		background-repeat: repeat-x;
	}

	/* phones: the tower stands behind the panels, its focus just above each one */
	@media (max-width: 47.5rem) {
		.static-tower {
			inset-inline: 0;
			inline-size: auto;
		}
		.static-tower :global(.static-tower__img) {
			inline-size: 100vw;
		}
	}
</style>

