---
/**
 * The tower for the static page (no 3D: reduced motion, no WebGL2, Save-Data, or the scene gave
 * up): one picture of the whole tower with every tier's point of interest turned to the front
 * (rendered by scripts/render-tower-still.mjs). As the page scrolls the tower moves the other
 * way, so each tier's focus comes level with that tier's panel: beside it on wide screens, just
 * above it on phones. It is close at each tier and draws back a little on the way between two;
 * at the base, where the page opens, it shows the whole tower, and closes in on the way up.
 * With reduced motion it doesn't travel: it holds each tier's view and fades to the next one's.
 * With Save-Data it isn't fetched at all.
 *
 * Decorative (`aria-hidden`; the panels carry the content), and only there with JavaScript: the
 * script picks the image size and does the placing, so without it nothing is fetched. Hidden
 * while the 3D tower is up (`html.webgl`).
 */
import { getImage } from 'astro:assets';
import tower from '../../assets/images/tower-front.webp';
import still from '../../data/tower-front.json';

/** Served widths; the script's `sizes` picks one for the zoomed-in size on screen. */
const WIDTHS = [900, 1500, 2100];
const sources = await Promise.all(WIDTHS.map((width) => getImage({ src: tower, width, format: 'webp', quality: 80 })));
const srcset = sources.map((s, i) => `${s.src} ${WIDTHS[i]}w`).join(', ');
---

<!-- the picture itself is added by the script below (without JavaScript nothing is fetched) -->
<div class="static-tower" data-static-tower data-srcset={srcset} data-foci={JSON.stringify(still.foci)} data-size={`${still.width}x${still.height}`} aria-hidden="true"></div>

<script>
	import { isTowerActive } from '../tower/mode';

	const box = document.querySelector<HTMLElement>('[data-static-tower]');
	const img = box ? document.createElement('img') : null;
	const sections = ['base', 'code', 'math', 'languages', 'making', 'summit'].map((id) => document.getElementById(`tier-${id}`));

	if (box && img && sections.every(Boolean)) {
		const tiers = sections as HTMLElement[];
		const panels = tiers.map((s) => s.querySelector<HTMLElement>('[data-tier-panel]')!);
		const foci = JSON.parse(box.dataset.foci ?? '[]') as number[];
		const phone = window.matchMedia('(max-width: 47.5rem)');
		const [w, h] = (box.dataset.size ?? '').split('x').map(Number);
		img.className = 'static-tower__img';
		img.alt = '';
		img.decoding = 'async';
		img.width = w;
		img.height = h;
		box.append(img);

		/** How close the tower is: at a tier, and the least it draws back to half-way between two. */
		const zoom = () => (phone.matches ? { near: 2.3, far: 1.9 } : { near: 2.4, far: 1.95 });
		/** 0 at a tier, 1 half-way to the next: flat around each tier, the change mostly in between. */
		const away = (t: number) => {
			const d = Math.min(t, 1 - t) * 2;
			const x = Math.min(1, Math.max(0, (d - 0.15) / 0.85));
			return x * x * (3 - 2 * x);
		};

		/** Reduced motion: the tower doesn't travel; it fades from one tier's view to the next. */
		const still = window.matchMedia('(prefers-reduced-motion: reduce)');
		// Save-Data: the picture is decoration, so it isn't fetched at all (the box never shows)
		const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
		if (!saveData) {
			// the size to fetch: the picture is drawn this much wider than its base width
			img.sizes = `calc(${phone.matches ? '100vw' : '46vw'} * ${zoom().near})`;
			img.srcset = box.dataset.srcset ?? '';
		}

		/** Where tier `k`'s focus should sit on screen: level with the middle of its panel, or (phone) just above the panel's top. */
		function spot(k: number, centred = false) {
			const r = panels[k].getBoundingClientRect();
			// as it would be with its tier centred in the window (for the view that holds still)
			let shift = 0;
			if (centred) {
				const sr = tiers[k].getBoundingClientRect();
				shift = sr.top + sr.height / 2 - window.innerHeight / 2;
			}
			return phone.matches ? Math.max(72, r.top - shift - 34) : r.top - shift + r.height / 2;
		}

		/** Where the scroll is among the tiers: between tier `i` and the next, `t` of the way. */
		function where() {
			const centres = tiers.map((s) => s.offsetTop + s.offsetHeight / 2);
			const mid = window.scrollY + window.innerHeight / 2;
			let i = 0;
			while (i < tiers.length - 2 && mid > centres[i + 1]) i++;
			return { i, t: Math.min(1, Math.max(0, (mid - centres[i]) / (centres[i + 1] - centres[i]))) };
		}

		/** The transform that puts `focus` (a fraction of the picture's height) at `y` on screen, at scale `s`. */
		function framing(focus: number, y: number, s: number) {
			const w0 = img!.offsetWidth;
			const boxW = box!.clientWidth;
			// the image sits at the box's inline-start edge: in RTL that is its right edge
			const rtl = getComputedStyle(box!).direction === 'rtl';
			const left = boxW / 2 - (s * w0) / 2;
			return { x: left - (rtl ? boxW - w0 : 0), y: y - s * focus * img!.offsetHeight, s };
		}

		/** Where the tower should be for the current scroll (translate x/y and scale). */
		function aim() {
			const { i, t } = where();
			const { near, far } = zoom();
			// from the base to the code tier: out of the whole tower, in to the doors
			if (i === 0) {
				const whole = overview();
				const e = t * t * (3 - 2 * t);
				const s = whole.s + (near - whole.s) * e;
				return framing(whole.focus + (foci[1] - whole.focus) * e, whole.y + (spot(1) - whole.y) * e, s);
			}
			const target = spot(i) + (spot(i + 1) - spot(i)) * t;
			return framing(foci[i] + (foci[i + 1] - foci[i]) * t, target, near - (near - far) * away(t));
		}

		/**
		 * The base tier's view: the whole tower, as on landing in the 3D climb. It fits the room below
		 * the header, its middle in the middle of it: beside the panel on wide screens (the window's
		 * height), above it on a phone (down to just past the panel's top, so its ground tucks under).
		 */
		function overview() {
			const top = 72;
			const bottom = phone.matches ? panels[0].getBoundingClientRect().top + 36 : window.innerHeight;
			const room = Math.max(160, bottom - top);
			const s = Math.min((room * 0.94) / img!.offsetHeight, (box!.clientWidth * 0.96) / img!.offsetWidth);
			return { s, focus: 0.5, y: top + room / 2 };
		}

		/** Reduced motion: the view of the tier nearest the middle of the window, held still. */
		let shownTier = -1;
		let fading = 0;
		function hold(force: boolean) {
			const { i, t } = where();
			const k = t < 0.5 ? i : i + 1;
			if (k === shownTier && !force) return;
			const apply = () => {
				shownTier = k;
				const whole = overview();
				const f = k === 0 ? framing(whole.focus, whole.y, whole.s) : framing(foci[k], spot(k, true), zoom().near);
				img!.style.transform = `translate(${f.x.toFixed(1)}px, ${f.y.toFixed(1)}px) scale(${f.s.toFixed(4)})`;
				box!.classList.remove('is-fading');
			};
			window.clearTimeout(fading);
			if (force || shownTier < 0) return apply();
			// out, the new view set while it can't be seen, back in
			box!.classList.add('is-fading');
			fading = window.setTimeout(apply, 220);
		}

		// eased toward its aim every frame, so a wheel's steps come out smooth
		const now = { x: 0, y: 0, s: 1 };
		let first = true;
		let frame = 0;
		let last = 0;
		function draw(time: number) {
			frame = 0;
			if (isTowerActive() || !img!.complete || !img!.naturalWidth) return;
			if (still.matches) {
				hold(first);
				first = false;
				return;
			}
			const to = aim();
			const dt = last ? Math.min(0.1, (time - last) / 1000) : 0;
			last = time;
			const k = first ? 1 : 1 - Math.exp(-dt * 12);
			first = false;
			now.x += (to.x - now.x) * k;
			now.y += (to.y - now.y) * k;
			now.s += (to.s - now.s) * k;
			img!.style.transform = `translate(${now.x.toFixed(1)}px, ${now.y.toFixed(1)}px) scale(${now.s.toFixed(4)})`;
			if (Math.abs(to.y - now.y) > 0.3 || Math.abs(to.s - now.s) > 0.0005 || Math.abs(to.x - now.x) > 0.3) schedule();
			else last = 0;
		}
		function schedule() {
			if (!frame) frame = requestAnimationFrame(draw);
		}

		img.addEventListener('load', () => {
			box.dataset.ready = '';
			first = true;
			schedule();
		});
		window.addEventListener('scroll', schedule, { passive: true });
		const replace = () => {
			first = true;
			schedule();
		};
		window.addEventListener('resize', replace);
		still.addEventListener('change', replace);
		// the static layout comes back if the 3D tower stops (or is never there): place it again then
		new ResizeObserver(replace).observe(document.body);
	}
</script>

<style>
	.static-tower {
		display: none;
		position: fixed;
		z-index: 0;
		inset-block: 0;
		inset-inline-end: 0;
		inline-size: 60vw;
		overflow: hidden;
		pointer-events: none;
		transition: opacity 0.22s ease;
	}
	/* reduced motion: between two tiers' views the tower fades out and back in, instead of travelling */
	.static-tower.is-fading {
		opacity: 0;
	}
	/* shown once its picture is in, only on the static page */
	:global(html:not(.webgl)) .static-tower[data-ready] {
		display: block;
	}
	/* towards the panels the picture fades out */
	:global([dir="rtl"]) .static-tower {
		mask-image: linear-gradient(to right, #000 72%, transparent);
	}
	:global([dir="ltr"]) .static-tower {
		mask-image: linear-gradient(to left, #000 72%, transparent);
	}

	/* the picture is created by the script, so it is outside this file's scope */
	.static-tower :global(.static-tower__img) {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
		inline-size: 46vw;
		block-size: auto;
		max-inline-size: none;
		transform-origin: 0 0;
		will-change: transform;
	}

	/* phones: the tower stands behind the panels, its focus just above each one */
	@media (max-width: 47.5rem) {
		.static-tower {
			inset-inline: 0;
			inline-size: auto;
		}
		:global([dir="rtl"]) .static-tower,
		:global([dir="ltr"]) .static-tower {
			mask-image: none;
		}
		.static-tower :global(.static-tower__img) {
			inline-size: 100vw;
		}
	}
</style>

