---
/**
 * The CV, read in place: a link carrying `data-opens="cv"` (the experience tier's CV by its title,
 * the summit's CV row) opens this dialog with the PDF shown full size over the tower, a download
 * button and a close button. It sits outside the tier panels: one opened from another tier would
 * be inside a faded panel, and take no clicks.
 *
 * A full-screen button takes the viewer to the browser's own full screen and back; Esc leaves it,
 * a second Esc closes. It is the sheet inside the dialog that goes full screen: the browser refuses
 * it to a modal dialog, which already sits in the top layer. Where the browser has no Fullscreen API the button stays hidden.
 *
 * Progressive: the dialog only takes over where the browser can show a PDF inline
 * (`navigator.pdfViewerEnabled`) on a screen wide enough to read it. Anywhere else (phones, no
 * JavaScript) the link keeps doing what it always did: open the PDF itself. The PDF is only
 * fetched when the dialog first opens.
 */
import LinkIcon from '../../theme/components/LinkIcon.vue';

interface Props {
	/** URL of the PDF. */
	src: string;
	/** The dialog's title, also the frame's accessible name. */
	title: string;
	downloadLabel: string;
	fullscreenLabel: string;
	exitFullscreenLabel: string;
	closeLabel: string;
	/** File name suggested when downloading. */
	fileName: string;
}

const { src, title, downloadLabel, fullscreenLabel, exitFullscreenLabel, closeLabel, fileName } = Astro.props;
---

<dialog class="cv-view" aria-labelledby="cv-view-title" data-cv-view data-src={src}>
	<div class="cv-view__sheet">
		<header class="cv-view__bar">
			<h2 id="cv-view-title" class="cv-view__title">
				<LinkIcon name="cv" size={20} />
				{title}
			</h2>
			<div class="cv-view__actions">
				<a class="sd-control sd-control--gold" href={src} download={fileName}>{downloadLabel}</a>
				<!-- one label shows at a time, by whether the sheet is full screen (CSS), so it is also the button's name -->
				<button class="sd-control cv-view__full" type="button" hidden>
					<span class="cv-view__enter">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
						{fullscreenLabel}
					</span>
					<span class="cv-view__leave">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
						{exitFullscreenLabel}
					</span>
				</button>
				<form method="dialog">
					<button class="sd-control" type="submit">{closeLabel}</button>
				</form>
			</div>
		</header>
		<!-- the frame gets its src on first open, so the PDF isn't fetched with the page -->
		<iframe class="cv-view__frame" title={title}></iframe>
	</div>
</dialog>

<script>
	const view = document.querySelector<HTMLDialogElement>('[data-cv-view]');
	const frame = view?.querySelector<HTMLIFrameElement>('.cv-view__frame');
	const wide = window.matchMedia('(min-width: 48rem)');
	const canShowPdf = () => (navigator as Navigator & { pdfViewerEnabled?: boolean }).pdfViewerEnabled === true && wide.matches;

	if (view && frame && typeof view.showModal === 'function') {
		document.querySelectorAll<HTMLAnchorElement>('a[data-opens="cv"]').forEach((link) => {
			link.addEventListener('click', (e) => {
				if (!canShowPdf() || e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return; // a new tab stays a new tab
				e.preventDefault();
				// no thumbnail pane, fitted to the width: the page reads at its largest
				if (!frame.src) frame.src = `${view.dataset.src ?? ''}#navpanes=0&view=FitH`;
				view.showModal();
			});
		});
		// a click on the backdrop (outside the sheet) closes it, like Esc and the close button
		view.addEventListener('click', (e) => {
			if (e.target === view) view.close();
		});

		const sheet = view.querySelector<HTMLElement>('.cv-view__sheet');
		const full = view.querySelector<HTMLButtonElement>('.cv-view__full');
		if (sheet && full && document.fullscreenEnabled && typeof sheet.requestFullscreen === 'function') {
			full.hidden = false;
			full.addEventListener('click', () => {
				if (document.fullscreenElement === sheet) void document.exitFullscreen();
				else sheet.requestFullscreen().catch(() => {});
			});
			// Esc in full screen only leaves it, whether the browser takes the key or hands it to the dialog
			view.addEventListener('cancel', (e) => {
				if (document.fullscreenElement !== sheet) return;
				e.preventDefault();
				void document.exitFullscreen();
			});
			// closing from full screen (the close button) leaves it too
			view.addEventListener('close', () => {
				if (document.fullscreenElement === sheet) void document.exitFullscreen();
			});
		}
	}
</script>

<style>
	.cv-view {
		inline-size: min(92vw, 62rem);
		block-size: min(92vh, 72rem);
		max-inline-size: none;
		max-block-size: none;
		padding: 0;
		display: none;
		flex-direction: column;
		color: var(--sd-text);
		background: linear-gradient(180deg, var(--sd-glass), var(--sd-glass-strong));
		backdrop-filter: blur(16px);
		border: 1px solid var(--sd-line);
		border-radius: 10px;
		box-shadow: var(--sd-shadow-panel);
		overflow: hidden;
	}
	.cv-view[open] {
		display: flex;
		animation: cv-in var(--sd-dur) var(--sd-ease);
	}
	@keyframes cv-in {
		from { opacity: 0; transform: translateY(14px) scale(0.98); }
	}
	.cv-view::backdrop {
		background: rgb(14 12 10 / 0.72);
		backdrop-filter: blur(6px);
	}

	.cv-view__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--sd-space-3);
		padding-block: var(--sd-space-3);
		padding-inline: var(--sd-space-5);
		border-block-end: 1px solid var(--sd-line);
	}
	.cv-view__title {
		display: inline-flex;
		align-items: center;
		gap: var(--sd-space-2);
		font-size: 1.35rem;
		color: var(--sd-text);
	}
	.cv-view__title :global(.sd-link-icon) {
		color: var(--sd-gold);
	}
	.cv-view__actions {
		display: flex;
		gap: var(--sd-space-2);
	}
	.cv-view__actions form {
		display: contents;
	}

	.cv-view__sheet {
		flex: 1;
		min-block-size: 0;
		display: flex;
		flex-direction: column;
	}
	/* the whole screen, in the dialog's glass, over the tower dimmed as under the dialog */
	.cv-view__sheet:fullscreen {
		background: linear-gradient(180deg, var(--sd-glass), var(--sd-glass-strong));
		backdrop-filter: blur(16px);
	}
	.cv-view__sheet::backdrop {
		background: rgb(14 12 10 / 0.72);
		backdrop-filter: blur(6px);
	}
	.cv-view__full[hidden],
	.cv-view__leave,
	.cv-view__sheet:fullscreen .cv-view__enter {
		display: none;
	}
	.cv-view__enter,
	.cv-view__sheet:fullscreen .cv-view__leave {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.cv-view__full svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.cv-view__frame {
		flex: 1;
		inline-size: 100%;
		min-block-size: 0;
		border: 0;
		background: var(--sd-limestone);
	}

	/* the page under the open dialog stays where it is */
	:global(html:has(dialog.cv-view[open])) {
		overflow: hidden;
	}
</style>

