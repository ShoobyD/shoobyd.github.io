---
/**
 * Before the first paint: switches the tower loader on for visitors who will get the 3D, and lays
 * the page out as the climb for those who won't (the still climb runs it, see ../tower/still-climb.ts),
 * so it doesn't start as the plain page and jump. Without JavaScript none of this runs, and the
 * page stays the plain one.
 * Place it in the page head: `<TowerLoaderBoot slot="head" />` (see TowerLoader.astro).
 */
---

<script is:inline>
	(function () {
		var root = document.documentElement;
		function stillClimb() {
			root.classList.add('sd-climb');
			// if nothing comes to run it (the tower island failed to load), the plain page comes back
			setTimeout(function () {
				if (!root.dataset.climb) root.classList.remove('sd-climb');
			}, 6000);
		}
		try {
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return stillClimb();
			if (new URLSearchParams(location.search).has('no3d')) return stillClimb();
			var connection = navigator.connection;
			if (connection && connection.saveData) return stillClimb();
			var gl = document.createElement('canvas').getContext('webgl2');
			if (!gl) return stillClimb();
			var lose = gl.getExtension('WEBGL_lose_context');
			if (lose) lose.loseContext();
			root.classList.add('sd-tower-loading');
			setTimeout(function () { root.classList.remove('sd-tower-loading'); }, 20000);
		} catch (e) {
			root.classList.remove('sd-tower-loading');
		}
	})();
</script>

