---
/**
 * The full-screen loader shown while the 3D tower downloads and compiles, so a visitor who will
 * get the climb meets it whole instead of watching the page re-lay itself.
 *
 * It only ever appears for visitors who will actually get the 3D: TowerLoaderBoot, an inline
 * script in <head>, runs before the first paint and repeats TowerScene's checks (WebGL 2, no
 * reduced motion, no Save-Data, no `?no3d`). When a check fails there is no loader and the page
 * is the still climb at once; without JavaScript, a message takes its place. TowerScene removes
 * the loading class when the scene is live or when it gives up; a 20 s fail-safe removes it if
 * the island never mounts.
 *
 * Keep the checks in TowerLoaderBoot in sync with `wanted()` / `hasWebGL2()` in TowerScene.vue,
 * and the class name with `LOADING_CLASS` in mode.ts (an inline script cannot import them).
 */
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<div class="tower-loader" aria-hidden="true">
	<div class="tower-loader__tower">
		<i></i><i></i><i></i><i></i><i></i>
	</div>
	<p>{label}</p>
</div>

<style is:global>
	/* hidden unless the head script switched it on; fades out over the live scene when removed */
	.tower-loader {
		position: fixed;
		z-index: 90;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 26px;
		background: var(--sd-sky-gradient);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 1.1s var(--sd-ease), visibility 0s linear 1.1s;
	}

	html.sd-tower-loading .tower-loader {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transition: none;
	}

	html.sd-tower-loading body {
		overflow: hidden;
	}

	.tower-loader p {
		margin: 0;
		font-family: var(--sd-font-display);
		font-size: 1.35rem;
		letter-spacing: 0.02em;
		color: var(--sd-limestone);
		text-shadow: var(--sd-shadow-text);
	}

	/* a tower laid brick by brick, base first, then taken down and laid again */
	.tower-loader__tower {
		display: grid;
		justify-items: center;
		gap: 4px;
		filter: drop-shadow(0 10px 24px rgb(20 16 12 / 0.35));
	}

	.tower-loader__tower i {
		display: block;
		block-size: 18px;
		background: var(--sd-ochre);
		border-radius: 3px;
		box-shadow: inset 0 -4px 0 var(--sd-ochre-deep), inset 0 3px 0 rgb(255 240 215 / 0.25);
		opacity: 0;
		animation: sd-lay-brick 2.4s var(--sd-ease) infinite;
	}

	.tower-loader__tower i:nth-child(1) { inline-size: 33px; animation-delay: 1.2s; }
	.tower-loader__tower i:nth-child(2) { inline-size: 54px; animation-delay: 0.9s; }
	.tower-loader__tower i:nth-child(3) { inline-size: 75px; animation-delay: 0.6s; }
	.tower-loader__tower i:nth-child(4) { inline-size: 96px; animation-delay: 0.3s; }
	.tower-loader__tower i:nth-child(5) {
		inline-size: 117px;
		animation-delay: 0s;
		background: var(--sd-limestone);
		box-shadow: inset 0 -4px 0 var(--sd-limestone-dk);
	}

	@keyframes sd-lay-brick {
		0% { opacity: 0; transform: translateY(-32px); }
		18%, 80% { opacity: 1; transform: none; }
		100% { opacity: 0; }
	}
</style>

