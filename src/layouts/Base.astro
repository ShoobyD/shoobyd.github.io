---
/**
 * Base layout for every new page: document language and direction, meta, the
 * ShoobyD theme, and the site shell (header, main, footer).
 *
 * `alternatePath` is the same page in the other language. Pass it only when that page
 * exists: it brings the language switch in the header, and the hreflang links that pair the two
 * pages for search engines (Hebrew, the default, is also the x-default). The switch changes the
 * page in place (i18n/lang-swap.ts), so the twin must be the same page in the other language.
 */
import '../theme/base.css';
import SiteHeader from '../theme/components/SiteHeader.vue';
import SiteFooter from '../theme/components/SiteFooter.vue';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { dirFor, otherLang, useTranslations, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	alternatePath?: string;
}

const { lang, title, description, alternatePath } = Astro.props;
const t = useTranslations(lang);
const dir = dirFor(lang);
const other = otherLang(lang);

const pageTitle = title ? `${title} · ${t('site.title')}` : t('site.title');
const pageDescription = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * The image a shared link shows (rendered by scripts/render-share-image.mjs, 1200×630), one per
 * language, with the words in it.
 */
const shareImages: Record<Lang, string> = { he: '/og/he.jpg', en: '/og/en.jpg' };
const shareImage = new URL(shareImages[lang], Astro.site);
const shareImageAlt = t('share.imageAlt');
const alternateHref = alternatePath ? getRelativeLocaleUrl(other, alternatePath) : undefined;
/** The page in each language, when it has a twin: for the hreflang links. */
const versions = alternateHref
	? ({ [lang]: canonical, [other]: new URL(alternateHref, Astro.site) } as Record<Lang, URL>)
	: undefined;
const ogLocales: Record<Lang, string> = { he: 'he_IL', en: 'en_US' };

const langSwitch = alternateHref
	? { href: alternateHref, label: t('lang.label'), ariaLabel: t('lang.aria'), hreflang: other }
	: undefined;
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="author" content="Baruch Mustakis (ShoobyD)" />
		<meta name="theme-color" content="#6f8fb3" />
		<link rel="canonical" href={canonical} />
		{versions && (
			<>
				<link rel="alternate" hreflang="he" href={versions.he} />
				<link rel="alternate" hreflang="en" href={versions.en} />
				<link rel="alternate" hreflang="x-default" href={versions.he} />
			</>
		)}
		<link rel="icon" href="/favicon.ico" sizes="any" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="ShoobyD" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocales[lang]} />
		{versions && <meta property="og:locale:alternate" content={ogLocales[other]} />}
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={shareImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={shareImage} />
		<meta name="twitter:image:alt" content={shareImageAlt} />
		<slot name="head" />
	</head>
	<body>
		<a class="sd-skip-link" href="#main">{t('nav.skip')}</a>
		<SiteHeader
			homeHref={getRelativeLocaleUrl(lang, '/')}
			brandName={t('brand.name')}
			brandTagline={t('brand.tagline')}
			homeLabel={t('nav.home')}
			langSwitch={langSwitch}
		>
			<slot name="header-actions" slot="actions" />
		</SiteHeader>
		<main id="main">
			<slot />
		</main>
		<SiteFooter
			credit={t('footer.credit')}
			copyright={t('footer.copyright', { year: new Date().getFullYear() })}
		/>
		<!-- the language switch changes the page in place, when it has a twin (a no-op without the switch) -->
		<script>
			import '../i18n/lang-swap';
		</script>
	</body>
</html>

